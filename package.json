{
  "name": "components-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "style-dictionary build --config style-dictionary.config.mjs",
    "predev": "npm run tokens",
    "dev": "vite",
    "prebuild": "npm run tokens",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:contract": "node scripts/check-contract.mjs",
    "check": "npm run tokens && npm run check:contract"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "style-dictionary": "^4.3.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  }
}
